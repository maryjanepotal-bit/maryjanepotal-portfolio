.ring-button-svg {
	position: absolute;
	inset: -5px;
	width: calc(100% + 10px);
	height: calc(100% + 10px);
	fill: none;
	stroke: var(--gold);
	stroke-width: 1.1;
	stroke-linecap: round;
	stroke-dasharray: 140 140;
	stroke-dashoffset: 140;
	transform: rotate(-90deg);
	transition: stroke-dashoffset .5s ease;
	pointer-events: none;
