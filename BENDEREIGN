/* =====================================================
   EXPERIENCE, MOMENTS, GROWTH, CONTACT
   ===================================================== */
.experience {
	background: var(--purple-deep);
	color: #fff;
	display: grid;
	grid-template-columns: .9fr 1.1fr;
	gap: clamp(48px, 7vw, 112px);
	align-items: center;
	justify-content: flex-start;
	overflow-x: hidden;
	padding-top: clamp(56px, 8vh, 92px);
	padding-bottom: clamp(44px, 7vh, 80px);
}

.experience-copy {
	max-width: 560px;
}

.experience-copy .eyebrow {
	margin-bottom: 20px;
	color: #d9c0ef;
}

.experience-copy h2 {
	max-width: 560px;
	font-size: clamp(48px, 5.4vw, 82px);
	line-height: .98;
	letter-spacing: -.025em;
	margin-bottom: 28px;
}

.experience-copy>p:not(.eyebrow) {
	max-width: 500px;
	color: rgba(255, 255, 255, .72);
	font-size: clamp(16px, 1.4vw, 19px);
	line-height: 1.75;
}

.experience-count {
	display: inline-flex;
	align-items: baseline;
	gap: 8px;
	margin-top: 34px;
	padding-top: 18px;
	border-top: 1px solid rgba(255, 255, 255, .2);
	color: rgba(255, 255, 255, .58);
	font-size: 14px;
	letter-spacing: .12em;
}

.experience-count span {
	color: #d9c0ef;
	font-family: 'Playfair Display', serif;
	font-size: 42px;
	line-height: 1;
}

.experience-carousel {
	position: relative;
	min-width: 0;
	padding-bottom: 2px;
}

.experience-carousel>img {
	height: clamp(400px, 59vh, 600px);
	width: 100%;
	object-fit: cover;
	border-radius: 12px;
	box-shadow: 0 22px 52px rgba(0, 0, 0, .28);
	filter: saturate(.94) contrast(1.03);
	transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1), transform 1s cubic-bezier(0.4, 0, 0.2, 1), filter .45s ease, box-shadow .45s ease;
}

.experience-carousel:hover>img {
	filter: saturate(1.04) contrast(1.05);
	box-shadow: 0 28px 64px rgba(0, 0, 0, .36);
}

.carousel-controls {
	position: absolute;
	right: 20px;
	bottom: 22px;
	display: flex;
	gap: 10px;
}

.carousel-controls button {
	width: 44px;
	height: 44px;
	border: 1px solid rgba(255, 255, 255, .4);
	border-radius: 50%;
	background: rgba(255, 255, 255, .92);
	color: var(--purple-deep);
	cursor: pointer;
	transition: transform .2s ease, background .2s ease;
}

.carousel-controls button:hover,
.carousel-controls button:focus-visible {
	background: #fff;
	transform: translateY(-3px);
}

.moments {
	background: var(--cream);
	overflow: hidden;
	justify-content: flex-start;
	padding-top: clamp(56px, 8vh, 92px);
	padding-bottom: clamp(44px, 7vh, 80px);
}

.moments-heading {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(280px, .8fr);
	gap: clamp(48px, 9vw, 144px);
	align-items: end;
	width: 100%;
	max-width: 1360px;
	margin: 0 auto clamp(42px, 6vh, 72px);
	text-align: left;
}

.moments-heading .eyebrow {
	margin-bottom: 20px;
	color: var(--purple);
}

.moments-heading h2 {
	max-width: 620px;
	margin-bottom: 0;
	font-size: clamp(48px, 6vw, 84px);
	letter-spacing: -.025em;
}

.moments-heading-copy {
	min-width: 0;
}

.moments-intro {
	max-width: 520px;
	margin: 0;
	justify-self: end;
	padding-bottom: 8px;
	color: var(--muted);
	font-size: clamp(15px, 1.35vw, 18px);
	line-height: 1.75;
}

.moments-window {
	position: relative;
	width: 100%;
	max-width: 1360px;
	margin: 0 auto;
	padding: 0 0 12px;
	overflow: hidden;
	mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
	-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
}

.moments-track {
	display: flex;
	gap: clamp(18px, 1.8vw, 28px);
	width: max-content;
	animation: moments var(--moments-speed) linear infinite;
}

.moments-track img {
	width: clamp(250px, 23vw, 360px);
	height: clamp(320px, 38vh, 460px);
	object-fit: cover;
	border-radius: 12px;
	box-shadow: 0 16px 36px rgba(32, 13, 44, .14);
	transition: transform .45s ease, box-shadow .45s ease, filter .45s ease;
	filter: saturate(.92) contrast(1.02);
}

.moments-track img:hover {
	transform: translateY(-8px) scale(1.015);
	box-shadow: 0 24px 48px rgba(32, 13, 44, .2);
	filter: saturate(1.05) contrast(1.04);
}

@keyframes moments {
	to {
		transform: translateX(-50%);
	}
}

.reign-club {
	background: var(--purple);
	color: #fff;
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 6vw;
	align-items: center;
}

.reign-signup {
	display: grid;
	gap: 12px;
	max-width: 500px;
}

.reign-signup input {
	width: 100%;
	padding: 14px 16px;
	border: 1px solid rgba(255, 255, 255, .25);
	background: rgba(255, 255, 255, .08);
	color: #fff;
	outline: none;
}

.growth-grid {
	background: var(--purple-deep);
	color: #fff;
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: clamp(48px, 6vw, 96px);
	align-items: stretch;
	padding: 0;
}

.growth {
	position: relative;
	justify-content: flex-start;
	grid-template-rows: auto auto auto;
	overflow-x: hidden;
	background: radial-gradient(circle at 86% 18%, rgba(75, 25, 121, .3), transparent 34%), var(--purple-deep);
	color: #fff;
	padding-top: clamp(40px, 5vh, 64px);
	padding-bottom: 0;
}

.growth .page-footer-flow {
	grid-column: 1 / -1;
	width: calc(100% + 10vw);
	margin-left: -5vw;
	margin-top: 20px;
}

.growth .site-footer {
	width: 100% !important;
	margin-left: 0;
	padding-top: 8px;
	padding-bottom: 8px;
	gap: 12px;
}

.growth-title {
	position: relative;
	max-width: 900px;
	width: 100%;
	margin-left: 0;
	margin-right: auto;
	padding: 0 0 26px 18px;
	border-bottom: 1px solid rgba(255, 255, 255, .16);
	margin-bottom: clamp(36px, 5vh, 60px);
	text-align: left;
}

.growth-title::before {
	position: absolute;
	left: 0;
	top: 2px;
	bottom: 26px;
	width: 2px;
	content: '';
	background: #d9c0ef;
	opacity: .72;
}

.growth-title .eyebrow {
	margin-bottom: 16px;
	font-size: 11px;
	font-weight: 700;
	letter-spacing: .19em;
	color: #f2e7ff;
}

.growth-title h2 {
	font-size: clamp(48px, 5.4vw, 82px);
	line-height: .98;
	letter-spacing: -.025em;
	margin-bottom: 0;
}

.growth-meta {
	position: absolute;
	right: 0;
	top: 4px;
	display: flex;
	align-items: center;
	justify-content: flex-end;
	gap: 10px;
	padding-bottom: 8px;
	color: rgba(255, 255, 255, .62);
	text-align: right;
}

.growth-meta span {
	font-size: 11px;
	font-weight: 700;
	letter-spacing: .16em;
}

.growth-meta i {
	display: block;
	width: 56px;
	flex: 0 0 56px;
	height: 1px;
	background: rgba(217, 192, 239, .55);
}

.growth-meta small {
	font-size: 10px;
	letter-spacing: .14em;
	text-transform: uppercase;
}

.growth-image img {
	height: clamp(380px, 54vh, 540px);
	width: 100%;
	object-fit: cover;
	border-radius: 16px;
	box-shadow: 0 18px 42px rgba(0, 0, 0, .24);
	filter: saturate(.92) contrast(1.03);
	transition: transform .5s ease, box-shadow .5s ease, filter .5s ease;
}

.growth-image {
	position: relative;
	z-index: 0;
}

.growth-image-label {
	position: absolute;
	left: 18px;
	bottom: 18px;
	z-index: 1;
	padding: 8px 12px;
	border: 1px solid rgba(255, 255, 255, .35);
	border-radius: 999px;
	background: rgba(23, 0, 41, .62);
	backdrop-filter: blur(8px);
	color: #fff;
	font-size: 10px;
	font-weight: 700;
	letter-spacing: .14em;
	text-transform: uppercase;
}

.growth-image::before {
	position: absolute;
	left: -10px;
	top: 10px;
	width: 100%;
	height: 100%;
	content: '';
	border: 1px solid rgba(217, 192, 239, .38);
	border-radius: 12px;
	z-index: -1;
	transition: transform .5s ease, border-color .5s ease;
}

.growth-image:hover::before {
	transform: translate(-6px, 6px);
	border-color: rgba(217, 192, 239, .7);
}

.growth-image:hover img {
	transform: scale(1.015);
	box-shadow: 0 26px 54px rgba(0, 0, 0, .32);
	filter: saturate(1.04) contrast(1.05);
}

.growth-copy {
	position: relative;
	z-index: 0;
	max-width: none;
	align-self: center;
	padding: clamp(26px, 3.5vw, 48px);
	border: 1px solid rgba(255, 255, 255, .14);
	border-left: 3px solid rgba(217, 192, 239, .72);
	border-radius: 16px;
	background: linear-gradient(145deg, rgba(255, 255, 255, .08), rgba(255, 255, 255, .025));
	box-shadow: 0 22px 48px rgba(0, 0, 0, .2);
}

.growth-copy::before {
	position: absolute;
	inset: 12% -8% -8% 8%;
	content: '';
	border-radius: 30px;
	background: radial-gradient(ellipse, rgba(217, 192, 239, .18), transparent 68%);
	filter: blur(18px);
	z-index: -1;
	pointer-events: none;
}

.growth-copy>p {
	margin-top: 0;
	margin-bottom: clamp(28px, 4vh, 44px);
	max-width: 520px;
	color: rgba(255, 255, 255, .72);
	font-size: clamp(16px, 1.4vw, 19px);
	line-height: 1.75;
	text-wrap: pretty;
}

.growth-copy .growth-supporting-line {
	margin-bottom: 12px;
	color: #d9c0ef;
	font-family: 'Playfair Display', serif;
	font-size: clamp(20px, 2vw, 28px);
	line-height: 1.25;
}

.growth-lines span {
	position: relative;
	counter-increment: growth-item;
	display: block;
	padding: 18px 32px 18px 42px;
	border-bottom: 0;
	font-family: 'Playfair Display', serif;
	font-size: clamp(19px, 1.8vw, 24px);
	transition: color .25s ease, padding-left .25s ease, border-color .25s ease;
}

.growth-lines {
	counter-reset: growth-item;
}

.growth-lines span::before {
	position: absolute;
	left: 0;
	top: 50%;
	content: counter(growth-item, decimal-leading-zero);
	color: rgba(217, 192, 239, .62);
	font-family: 'DM Sans', sans-serif;
	font-size: 11px;
	font-weight: 700;
	letter-spacing: .12em;
	transform: translateY(-50%);
}

.growth-lines span::after {
	position: absolute;
	right: 0;
	top: 50%;
	content: '↗';
	color: rgba(217, 192, 239, .62);
	font-family: 'DM Sans', sans-serif;
	font-size: 16px;
	transform: translateY(-50%);
	transition: color .25s ease, transform .25s ease;
}

.growth-lines span:first-child {
	border-top: 0;
}

.growth-lines span:hover {
	padding-left: 52px;
	color: #d9c0ef;
}

.growth-lines span:hover::after {
	color: #d9c0ef;
	transform: translate(4px, -50%);
}

.growth-action {
	display: inline-flex;
	align-items: center;
	gap: 10px;
	margin-top: 28px;
	padding-bottom: 6px;
	border-bottom: 1px solid rgba(217, 192, 239, .6);
	color: #d9c0ef;
	font-size: 12px;
	font-weight: 700;
	letter-spacing: .12em;
	text-transform: uppercase;
	transition: gap .25s ease, color .25s ease, border-color .25s ease;
}

.growth-action span {
	font-size: 16px;
}

.growth-action:hover,
.growth-action:focus-visible {
	gap: 15px;
	color: #fff;
	border-color: #fff;
}

.contact {
	background: var(--purple-deep);
	color: #fff;
	display: grid;
	grid-template-columns: 1.05fr .95fr;
	grid-template-rows: minmax(0, 1fr) auto;
	gap: clamp(36px, 4vw, 64px);
	width: 100%;
	max-width: none;
	margin-left: 0;
	margin-right: 0;
	align-items: center;
	justify-content: flex-start;
	overflow-x: hidden;
	padding-left: clamp(32px, 6vw, 96px);
	padding-right: clamp(32px, 6vw, 96px);
	padding-top: clamp(56px, 8vh, 92px);
	padding-bottom: 0;
}

.contact-copy,
.enquiry {
	min-width: 0;
}

.contact .page-footer-flow {
	grid-column: 1 / -1;
	width: calc(100% + 12vw);
	margin-left: -6vw;
	margin-top: 20px;
}

.contact .site-footer {
	width: 100% !important;
	margin-left: 0;
	padding-top: 8px;
	padding-bottom: 8px;
	gap: 12px;
}

.contact-copy {
	width: 100%;
	max-width: 620px;
}

.contact-copy .eyebrow {
	margin-bottom: 20px;
	color: #d9c0ef;
}

.contact-copy h2 {
	max-width: 620px;
	font-size: clamp(44px, 4.8vw, 76px);
	line-height: .98;
	letter-spacing: -.025em;
	margin-bottom: 32px;
	padding-bottom: 30px;
	border-bottom: 1px solid rgba(255, 255, 255, .16);
}

.contact-icons {
	display: grid;
	gap: 14px;
	max-width: 560px;
}

.contact-icons a {
	display: grid;
	grid-template-columns: 42px 1fr;
	gap: 14px;
	align-items: center;
	padding: 14px 16px;
	border: 1px solid rgba(255, 255, 255, .14);
	border-radius: 10px;
	color: rgba(255, 255, 255, .78);
	line-height: 1.5;
	transition: background .25s ease, border-color .25s ease, transform .25s ease, color .25s ease;
}

.contact-icons a:hover {
	background: rgba(255, 255, 255, .08);
	border-color: rgba(217, 192, 239, .48);
	color: #fff;
	transform: translateX(6px);
}

.contact-icons a b {
	width: 42px;
	height: 42px;
	display: grid;
	place-items: center;
	border-radius: 50%;
	background: rgba(217, 192, 239, .14);
	color: #d9c0ef;
	font-size: 16px;
}

.enquiry {
	background: rgba(255, 255, 255, .96);
	color: var(--ink);
	padding: clamp(28px, 4vw, 48px);
	display: grid;
	gap: 20px;
	width: 100%;
	max-width: 620px;
	justify-self: end;
	align-self: center;
	border: 1px solid rgba(255, 255, 255, .78);
	border-radius: 16px;
	box-shadow: 0 24px 60px rgba(0, 0, 0, .22);
}

.enquiry input,
.enquiry textarea {
	width: 100%;
	border: 1px solid rgba(53, 16, 95, .18);
	background: #fff;
	color: var(--ink);
	padding: 13px 14px;
	outline: none;
	border-radius: 8px;
	font-size: 14px;
	transition: border-color .2s ease, box-shadow .2s ease;
}

.enquiry textarea {
	min-height: 130px;
	resize: vertical;
}

.enquiry input:focus,
.enquiry textarea:focus {
	border-color: var(--purple-mid);
	box-shadow: 0 0 0 3px rgba(75, 25, 121, .12);
}

.enquiry .button {
	width: 100%;
	min-height: 48px;
	background: var(--purple);
	color: #fff;
	padding: 14px 18px;
	border: 0;
	border-radius: 8px;
	font-weight: 700;
	line-height: 1.2;
	cursor: pointer;
	box-shadow: 0 8px 18px rgba(53, 16, 95, .18);
	transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
}

.enquiry .button:hover,
.enquiry .button:focus-visible {
	background: var(--purple-mid);
	transform: translateY(-2px);
	box-shadow: 0 10px 22px rgba(53, 16, 95, .25);
}

