		radial-gradient(circle at 85% 20%, rgba(106, 57, 171, .18) 0%, transparent 50%),
		radial-gradient(circle at 15% 85%, rgba(75, 30, 120, .12) 0%, transparent 45%),
		#0d0d12;
	color: #f5f5f7;
}

#kitchen,
.experience {
