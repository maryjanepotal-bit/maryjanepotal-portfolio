/* =========================================================
   BENDEREIGN FIXED-FRAME (BOOK VIEW) STYLESHEET
   ========================================================= */
:root {
	--purple: #35105f;
	--purple-deep: #170029;
	--purple-mid: #4b1979;
	--cream: #f5efe4;
	--ink: #1d1422;
	--muted: #766e79;
	--white: #fff;
	--line: rgba(53, 16, 95, .15);
	--moments-speed: 34s;
	--page-bg: var(--cream);
	--page-text: var(--ink);
	--footer-bg: var(--purple-deep);
	--footer-text: #fff;
	--footer-muted: rgba(255, 255, 255, .65);
	--footer-line: rgba(255, 255, 255, .35);
}

*,
*::before,
*::after {
	box-sizing: border-box;
}

/* Screen Lockdown para sa Single-Section App View */
html,
body {
	height: 100%;
	margin: 0;
	padding: 0;
	background: var(--page-bg);
	color: var(--page-text);
	font-family: 'DM Sans', sans-serif;
	overflow: hidden;
}

body::before {
	position: fixed;
	inset: 0;
	content: '';
	z-index: 1;
	pointer-events: none;
	opacity: .12;
	mix-blend-mode: soft-light;
	background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
}

img {
	display: block;
	width: 100%;
}

a {
	color: inherit;
	text-decoration: none;
}

button,
input,
textarea {
	font: inherit;
}

/* =====================================================
   FIXED VIEWPORT CONTAINER & SECTION SWAPPING
   ===================================================== */
main {
	position: fixed;
	inset: 76px 0 0;
	overflow: hidden;
}

body.home-active main {
	inset: 0;
}

/* Tanging ACTIVE section lang ang makikita */
main>section {
	position: absolute;
	inset: 0;
	height: 100%;
	min-height: 0;
	overflow-y: auto;
	overflow-x: hidden;
	scroll-behavior: smooth;
	visibility: hidden;
	opacity: 0;
	transform: translateY(8px);
	pointer-events: none;
	transition: opacity .35s ease, transform .35s ease, visibility 0s linear .35s;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}

main>section.active-section {
	visibility: visible;
	opacity: 1;
	transform: none;
	pointer-events: auto;
	transition-delay: 0s;
}

/* Wrapper centering & border resets */
