function initializeMenu() {
    renderFilters();
    renderCategories();

    const menuSearch = $('#menuSearch');
    const menuViewToggle = $('#menuViewToggle');
    const gridViewButton = $('#menuGridView');
    const listViewButton = $('#menuListView');
    menuSearch?.addEventListener('input', () => {
        const query = menuSearch.value.trim().toLowerCase();
        $$('.menu-card', $('#menuGrid')).forEach(card => {
            card.hidden = query && !card.textContent.toLowerCase().includes(query);
        });
    });
    menuViewToggle?.addEventListener('click', () => {
        const grid = $('#menuGrid');
        const list = grid?.classList.toggle('list-view');
        if (menuViewToggle) menuViewToggle.textContent = list ? '⊞' : '☷';
    });

    const setMenuView = view => {
        const grid = $('#menuGrid');
        if (!grid) return;
        grid.classList.add('is-switching');
        window.setTimeout(() => {
            grid.classList.toggle('view-list', view === 'list');
            grid.classList.toggle('view-grid', view === 'grid');
            grid.classList.remove('is-switching');
        }, 150);
        gridViewButton?.classList.toggle('active', view === 'grid');
        listViewButton?.classList.toggle('active', view === 'list');
        gridViewButton?.setAttribute('aria-pressed', String(view === 'grid'));
        listViewButton?.setAttribute('aria-pressed', String(view === 'list'));
    };

    gridViewButton?.addEventListener('click', () => setMenuView('grid'));
    listViewButton?.addEventListener('click', () => setMenuView('list'));
    setMenuView('grid');
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeMenu, { once: true });
} else {
    initializeMenu();
}

