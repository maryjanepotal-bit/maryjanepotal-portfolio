/* =====================================================
   UTILITY ACTION STACK
   ===================================================== */
.floating-actions-container {
	position: fixed;
	right: 18px;
	bottom: 18px;
	z-index: 240;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12px;
	transition: opacity .25s ease, transform .25s ease;
}

.whatsapp-float,
.back-to-top {
	position: static;
	width: 44px;
	height: 44px;
	border-radius: 50%;
	display: grid;
	place-items: center;
	border: 1px solid rgba(197, 168, 128, .38);
	background: rgba(18, 12, 20, .7);
	color: #f5efe4;
	backdrop-filter: blur(8px);
	box-shadow: 0 10px 28px rgba(18, 12, 20, .24);
	transition: transform .2s ease, background .2s ease, border-color .2s ease, opacity .2s ease;
}

.whatsapp-float {
	font-size: 19px;
	padding: 0;
	text-decoration: none;
	cursor: pointer;
	background: rgba(12, 8, 15, .72);
	color: #f5efe4;
}

.back-to-top {
	position: relative;
	background: rgba(255, 255, 255, .08);
	color: #f5efe4;
	opacity: 0;
	pointer-events: none;
	transform: translateY(8px);
	cursor: pointer;
	overflow: visible;
}

.back-to-top-ring {
	position: absolute;
	inset: -4px;
	width: calc(100% + 8px);
	height: calc(100% + 8px);
	fill: none;
	stroke: #c5a880;
	stroke-width: 1.25;
	stroke-linecap: round;
	stroke-dasharray: 118 126;
	stroke-dashoffset: 118;
	transform: rotate(-90deg);
	transition: stroke-dashoffset .5s ease;
	pointer-events: none;
}

.back-to-top-arrow {
	position: relative;
	width: 9px;
	height: 9px;
	border-top: 1.5px solid #c5a880;
	border-left: 1.5px solid #c5a880;
	transform: translateY(1px) rotate(45deg);
	transition: transform .25s ease;
}

.back-to-top:hover,
.back-to-top:focus-visible {
	transform: translateY(-2px);
	border-color: rgba(197, 168, 128, .7);
	background: rgba(53, 16, 95, .76);
}

.back-to-top:hover .back-to-top-ring,
.back-to-top:focus-visible .back-to-top-ring {
	stroke-dashoffset: 0;
}

.back-to-top:hover .back-to-top-arrow,
.back-to-top:focus-visible .back-to-top-arrow {
	transform: translateY(-3px) rotate(45deg);
}

.back-to-top.show {
	opacity: 1;
	pointer-events: auto;
	transform: translateY(0);
}

body.home-active .floating-actions-container,
body.home-active .whatsapp-float,
body.home-active .back-to-top {
	opacity: 0;
	pointer-events: none;
}

