	-webkit-text-fill-color: transparent;
}

/* Concentric Circles (Nakatago muna, lalabas lang pag hinover) */
.ripple-circle {
	position: absolute;
	width: 65px;
	height: 65px;
	border: 1px solid rgba(191, 149, 63, 0.6);
	/* Gold ring color */
	border-radius: 50%;
	opacity: 0;
	z-index: 1;
	pointer-events: none;
}

/* Kapag hinover ang logo-wrapper, magsisimula ang wave animation */
.logo-wrapper:hover .ripple-circle {
	animation: rippleEffect 1.5s infinite ease-out;
}

.logo-wrapper:hover .ripple-circle.delay {
	animation-delay: 0.5s;
	/* Para sa ikalawang circle na may sunod-sunod na galaw */
}

.logo-wrapper:hover .drawer-logo {
	transform: scale(1.05);
	/* Konting zoom effect sa logo */
}

/* Keyframes para sa paglaki ng concentric waves */
@keyframes rippleEffect {
	0% {
		width: 65px;
		height: 65px;
		opacity: 0.8;
	}

	100% {
		width: 130px;
		height: 130px;
		opacity: 0;
	}
}

/* Divider Line */
.divider {
	width: 50%;
	border: none;
	height: 1px;
	background: linear-gradient(to right, transparent, rgba(191, 149, 63, 0.6), transparent);
	margin: 20px 0 30px 0;
}

/* Minimalist Social Icons */
.social-pages {
	display: flex;
	gap: 24px;
	justify-content: center;
	align-items: center;
}

.social-icon {
	font-size: 18px;
	text-decoration: none;
	transition: transform 0.2s ease, opacity 0.2s ease;
	background: linear-gradient(135deg, #bf953f 0%, #fcf6ba 25%, #b38728 50%, #fbf5b7 75%, #aa771c 100%);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	display: inline-block;
}

.social-icon:hover {
	transform: scale(1.1);
	opacity: 0.85;
}
