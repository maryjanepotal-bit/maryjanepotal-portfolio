/* =========================================================
   BENDEREIGN DARK LUXURY ARCHITECTURE OVERRIDES
   ========================================================= */
:root {
	--purple: #6a39ab;
	--purple-deep: #0d0d12;
	--purple-mid: #7b4fc2;
	--cream: #17161d;
	--ink: #f5f5f7;
	--muted: #aaa7b2;
	--white: #f5f5f7;
	--line: rgba(197, 168, 128, .22);
	--page-bg: #0d0d12;
	--page-text: #f5f5f7;
	--footer-bg: #111018;
	--footer-text: #f5f5f7;
	--footer-muted: rgba(245, 245, 247, .62);
	--footer-line: rgba(197, 168, 128, .28);
	--gold: #c5a880;
}

html,
body {
	background: #0d0d12;
	color: #f5f5f7;
}

body::before {
	opacity: .08;
	mix-blend-mode: screen;
}

main {
	inset: 0;
}

.site-header,
body.home-active .site-header {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: auto;
	min-height: 84px;
	z-index: 100;
	padding: 30px 60px;
	background: transparent;
	backdrop-filter: none;
	border-bottom: 1px solid rgba(255, 255, 255, .12);
}

.brand-name,
.site-header a,
.desktop-nav a {
	color: #f5f5f7;
}

.desktop-nav {
	gap: clamp(18px, 2.2vw, 34px);
	margin-right: 28px;
}

.desktop-nav a {
	position: relative;
	padding: 8px 0;
	font-size: 10px;
	letter-spacing: .18em;
	text-decoration: none !important;
}

.desktop-nav a::before,
.desktop-nav a::after,
.desktop-nav a span::after {
	position: absolute;
	left: 0;
	width: 100%;
	height: 1px;
	content: '';
	background: var(--gold);
	transform: scaleX(0);
	transform-origin: left;
	transition: transform .35s ease;
}

.desktop-nav a::before {
	bottom: 1px;
	transition-delay: 0s;
}

.desktop-nav a::after {
	bottom: -3px;
	transition-delay: .08s;
}

.desktop-nav a span::after {
	bottom: -7px;
	transition-delay: .16s;
}

.desktop-nav a:hover::before,
.desktop-nav a:hover::after,
.desktop-nav a:hover span::after,
.desktop-nav a.active-nav::before,
.desktop-nav a.active-nav::after,
.desktop-nav a.active-nav span::after {
	transform: scaleX(1);
}

.menu-toggle {
	width: 28px;
	height: 24px;
	padding: 0;
	margin-left: 0;
}

.menu-toggle span {
	width: 24px;
	height: 1px;
	margin: 0 0 6px auto;
	background: var(--gold);
	transition: transform .3s ease, width .3s ease;
}

.menu-toggle span:nth-child(2) {
	width: 17px;
}

.menu-toggle span:nth-child(3) {
	width: 11px;
	margin-bottom: 0;
}

.menu-toggle:hover span {
	transform: none;
	width: 24px;
}

.hero,
.story,
.menu-section,
.moments,
.reign-club,
.contact {
	background: #0d0d12;
	color: #f5f5f7;
}

.story-copy,
.story-copy .lead,
.story-copy>p,
.menu-intro>p,
.moments-intro,
.menu-card p {
	color: #aaa7b2;
}

.eyebrow,
.story-copy .eyebrow,
.menu-card-body small,
.leader-role,
.leader-copy small,
.visit-follow,
.visit-kicker {
	color: var(--gold);
}

.dark-section,
#minds {
