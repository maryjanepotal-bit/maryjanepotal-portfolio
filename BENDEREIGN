// =====================================================
const counter = $('.counter');
if (counter) {
    let started = false;
    const runCounter = () => {
        if (started) return;
        started = true;
        let n = 0;
        const t = +counter.dataset.target;
        const x = setInterval(() => {
            n += 4;
            counter.textContent = Math.min(n, t);
            if (n >= t) clearInterval(x);
        }, 28);
    };
    
    const ci = new IntersectionObserver(es => {
        es.forEach(e => {
            if (e.isIntersecting) runCounter();
        });
    });
    ci.observe(counter);
}

